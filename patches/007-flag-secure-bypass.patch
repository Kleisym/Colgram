+        if (org.colgram.core.ColgramHookHandler.shouldBypassFlagSecure()) {
+            secure = false;
+        }
         if (parentActivity != null && parentActivity.getWindow() != null) {
             if (secure) {
                 parentActivity.getWindow().addFlags(WindowManager.LayoutParams.FLAG_SECURE);
