+        if (obj.messageOwner.action != null && !(obj.messageOwner.action instanceof TLRPC.TL_messageActionEmpty)) {
+            return false;
+        }
+        if (obj.type == MessageObject.TYPE_DATE
+                || obj.type == MessageObject.TYPE_LOADING
+                || obj.type == MessageObject.TYPE_JOINED_CHANNEL
+                || obj.type == MessageObject.TYPE_GIFT_STARS
+                || obj.type == MessageObject.TYPE_SUGGEST_PHOTO
+                || obj.type == MessageObject.TYPE_ACTION_PHOTO
+                || obj.type == MessageObject.TYPE_ACTION_WALLPAPER
+                || obj.type == MessageObject.TYPE_GIFT_THEME_UPDATE) {
+            return false;
+        }
+        if (obj.isAnyGift() || obj.isWallpaperAction() || obj.isSponsored() || obj.isEphemeral()) {
+            return false;
+        }
+        if (threadMessageObjects != null && threadMessageObjects.contains(obj) && !isThreadChat()) {
+            return false;
+        }
+        int type = getMessageType(obj);
+        return type >= 2 && type != 20 && type != MessageObject.TYPE_SUGGEST_PHOTO;
+    }
