+    /**
+     * Worst contrast a foreground colour gets against any surface it could plausibly
+     * be drawn on.
+     *
+     * The guard used to measure everything against windowBackgroundWhite alone. That
+     * is wrong twice over: a colour inside a chat, a dialog sheet or an action bar sits
+     * on its own background, so a readable colour could be 'repaired' against the wrong
+     * surface, and an unreadable one could slip through because it happened to contrast
+     * well with the one surface we happened to check.
+     *
+     * Colour keys carry no name at runtime (they are sequential colorsCount++ ints and
+     * Theme exposes no key->String), so we cannot know which family a key belongs to.
+     * The text can be drawn on ANY of these surfaces, so the MINIMUM is the useful
+     * signal. The old maximum let medium-grey text pass because it contrasted on black
+     * while disappearing on a charcoal sheet or panel.
+     */
+    private static double colgramWorstWcagContrast(int color, boolean cyber, ResourcesProvider provider) {
+        if ((color >>> 24) < 0x20) {
+            return 21.0;
+        }
+        if (cyber) {
+            double worstCyber = org.colgram.core.ColgramThemePolicy.contrast(color, COLGRAM_CYBER_BG);
+            worstCyber = Math.min(worstCyber, org.colgram.core.ColgramThemePolicy.contrast(color, COLGRAM_CYBER_SURFACE));
+            worstCyber = Math.min(worstCyber, org.colgram.core.ColgramThemePolicy.contrast(color, COLGRAM_CYBER_FIELD));
+            return worstCyber;
+        }
+        double worst = org.colgram.core.ColgramThemePolicy.contrast(
+                color, colgramEffectiveColor(key_windowBackgroundWhite, false, provider));
+        worst = Math.min(worst, org.colgram.core.ColgramThemePolicy.contrast(
+                color, colgramEffectiveColor(key_windowBackgroundGray, false, provider)));
+        worst = Math.min(worst, org.colgram.core.ColgramThemePolicy.contrast(
+                color, colgramEffectiveColor(key_dialogBackground, false, provider)));
+        worst = Math.min(worst, org.colgram.core.ColgramThemePolicy.contrast(
+                color, colgramEffectiveColor(key_actionBarDefault, false, provider)));
+        worst = Math.min(worst, org.colgram.core.ColgramThemePolicy.contrast(
+                color, colgramEffectiveColor(key_chat_messagePanelBackground, false, provider)));
+        return worst;
+    }
+
+    private static int colgramWorstContrast(int key, int color, boolean cyber) {
+        if (cyber) {
+            int worstCyber = colgramContrast(color, COLGRAM_CYBER_BG);
+            worstCyber = Math.min(worstCyber, colgramContrast(color, COLGRAM_CYBER_SURFACE));
+            worstCyber = Math.min(worstCyber, colgramContrast(color, COLGRAM_CYBER_FIELD));
+            return worstCyber;
+        }
+        int worst = colgramContrast(color, colgramGetColorInternal(key_windowBackgroundWhite, null, true));
+        worst = Math.min(worst, colgramContrast(color, colgramGetColorInternal(key_dialogBackground, null, true)));
+        worst = Math.min(worst, colgramContrast(color, colgramGetColorInternal(key_actionBarDefault, null, true)));
+        return worst;
+    }
