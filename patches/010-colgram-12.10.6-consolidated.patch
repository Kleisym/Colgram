+    private static final class ColgramDockPager extends ViewGroup {
+        interface ProgressListener {
+            void onProgress(float pageProgress);
+        }
+
+        private final OverScroller scroller;
+        private final int touchSlop;
+        private final int minFlingVel;
+        private final int maxFlingVel;
+        private VelocityTracker velocityTracker;
+        private ProgressListener progressListener;
+        private int pageWidth;
+        private int currentPage;
+        private float downX;
+        private float downY;
+        private float lastX;
+        private boolean dragging;
+
+        ColgramDockPager(Context context) {
+            super(context);
+            scroller = new OverScroller(context, CubicBezierInterpolator.EASE_OUT_QUINT);
+            ViewConfiguration vc = ViewConfiguration.get(context);
+            touchSlop = vc.getScaledTouchSlop();
+            minFlingVel = vc.getScaledMinimumFlingVelocity();
+            maxFlingVel = vc.getScaledMaximumFlingVelocity();
+        }
+
+        void setOnScrollProgressListener(ProgressListener listener) {
+            this.progressListener = listener;
+        }
+
+        int getCurrentPage() {
+            return currentPage;
+        }
+
+        void setCurrentPage(int page, boolean animated) {
+            int maxPage = Math.max(0, getChildCount() - 1);
+            currentPage = MathUtils.clamp(page, 0, maxPage);
+            if (pageWidth <= 0) {
+                if (progressListener != null) {
+                    progressListener.onProgress(currentPage);
+                }
+                return;
+            }
+            int targetX = currentPage * pageWidth;
+            if (!scroller.isFinished()) {
+                scroller.abortAnimation();
+            }
+            if (animated) {
+                scroller.startScroll(getScrollX(), 0, targetX - getScrollX(), 0, 260);
+                postInvalidateOnAnimation();
+            } else {
+                scrollTo(targetX, 0);
+                if (progressListener != null) {
+                    progressListener.onProgress(currentPage);
+                }
+            }
+        }
+
+        @Override
+        protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+            pageWidth = Math.max(1, MeasureSpec.getSize(widthMeasureSpec));
+            int h = dp(DialogsActivity.MAIN_TABS_HEIGHT);
+            int childWSpec = MeasureSpec.makeMeasureSpec(pageWidth, MeasureSpec.EXACTLY);
+            int childHSpec = MeasureSpec.makeMeasureSpec(h, MeasureSpec.EXACTLY);
+            for (int i = 0; i < getChildCount(); i++) {
+                getChildAt(i).measure(childWSpec, childHSpec);
+            }
+            setMeasuredDimension(pageWidth, h);
+            if (!dragging && scroller.isFinished()) {
+                int maxPage = Math.max(0, getChildCount() - 1);
+                currentPage = MathUtils.clamp(currentPage, 0, maxPage);
+                scrollTo(currentPage * pageWidth, 0);
+            }
+        }
+
+        @Override
+        protected void onLayout(boolean changed, int l, int t, int r, int b) {
+            int h = b - t;
+            for (int i = 0; i < getChildCount(); i++) {
+                getChildAt(i).layout(i * pageWidth, 0, (i + 1) * pageWidth, h);
+            }
+        }
+
+        @Override
+        public boolean onInterceptTouchEvent(MotionEvent ev) {
+            if (getChildCount() <= 1) {
+                return false;
+            }
+            int action = ev.getActionMasked();
+            if (action == MotionEvent.ACTION_DOWN) {
+                if (!scroller.isFinished()) {
+                    scroller.abortAnimation();
+                }
+                downX = lastX = ev.getX();
+                downY = ev.getY();
+                dragging = false;
+                if (velocityTracker == null) {
+                    velocityTracker = VelocityTracker.obtain();
+                } else {
+                    velocityTracker.clear();
+                }
+                velocityTracker.addMovement(ev);
+                return false;
+            }
+            if (action == MotionEvent.ACTION_MOVE) {
+                if (velocityTracker != null) {
+                    velocityTracker.addMovement(ev);
+                }
+                float dx = Math.abs(ev.getX() - downX);
+                float dy = Math.abs(ev.getY() - downY);
+                if (dx > touchSlop && dx > dy * 1.1f) {
+                    dragging = true;
+                    lastX = ev.getX();
+                    if (getParent() != null) {
+                        getParent().requestDisallowInterceptTouchEvent(true);
+                    }
+                    return true;
+                }
+            } else if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) {
+                dragging = false;
+                if (velocityTracker != null) {
+                    velocityTracker.recycle();
+                    velocityTracker = null;
+                }
+            }
+            return dragging;
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent ev) {
+            if (getChildCount() <= 1) {
+                return false;
+            }
+            if (velocityTracker == null) {
+                velocityTracker = VelocityTracker.obtain();
+            }
+            velocityTracker.addMovement(ev);
+            int action = ev.getActionMasked();
+            if (action == MotionEvent.ACTION_DOWN) {
+                if (!scroller.isFinished()) {
+                    scroller.abortAnimation();
+                }
+                downX = lastX = ev.getX();
+                downY = ev.getY();
+                return true;
+            } else if (action == MotionEvent.ACTION_MOVE) {
+                float curX = ev.getX();
+                if (!dragging && Math.abs(curX - downX) > touchSlop) {
+                    dragging = true;
+                    if (getParent() != null) {
+                        getParent().requestDisallowInterceptTouchEvent(true);
+                    }
+                }
+                if (dragging && pageWidth > 0) {
+                    float delta = lastX - curX;
+                    int maxScroll = Math.max(0, (getChildCount() - 1) * pageWidth);
+                    int next = MathUtils.clamp(Math.round(getScrollX() + delta), 0, maxScroll);
+                    scrollTo(next, 0);
+                    if (progressListener != null) {
+                        progressListener.onProgress((float) next / pageWidth);
+                    }
+                }
+                lastX = curX;
+                return true;
+            } else if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) {
+                if (dragging && pageWidth > 0) {
+                    velocityTracker.computeCurrentVelocity(1000, maxFlingVel);
+                    float vx = velocityTracker.getXVelocity();
+                    int maxPage = Math.max(0, getChildCount() - 1);
+                    int target;
+                    if (vx < -minFlingVel) {
+                        target = Math.min(maxPage, currentPage + 1);
+                    } else if (vx > minFlingVel) {
+                        target = Math.max(0, currentPage - 1);
+                    } else {
+                        target = MathUtils.clamp(Math.round((float) getScrollX() / pageWidth), 0, maxPage);
+                    }
+                    setCurrentPage(target, true);
+                }
+                dragging = false;
+                if (velocityTracker != null) {
+                    velocityTracker.recycle();
+                    velocityTracker = null;
+                }
+                return true;
+            }
+            return super.onTouchEvent(ev);
+        }
+
+        @Override
+        public void computeScroll() {
+            if (scroller.computeScrollOffset()) {
+                int x = scroller.getCurrX();
+                scrollTo(x, 0);
+                if (progressListener != null && pageWidth > 0) {
+                    progressListener.onProgress((float) x / pageWidth);
+                }
+                postInvalidateOnAnimation();
+            }
+        }
+    }
