+        patternInput.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourcesProvider));
+        patternInput.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+        root.addView(patternInput, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+
+        EditTextBoldCursor replaceInput = new EditTextBoldCursor(ctx);
