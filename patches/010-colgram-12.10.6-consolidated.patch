+    private String colgramSystemDpiStatus() {
+        Context ctx = getContext();
+        String st = org.colgram.core.ColgramCallSocksTunnel.systemDpiStatus(ctx);
+        if ("running".equals(st)) {
+            return "Активен для всего телефона (SNI-разрез + DoH + QUIC-блок)";
+        }
+        if ("starting".equals(st) || colgramSystemDpiPending) {
+            return "Запуск системного локального обхода…";
+        }
+        return "YouTube, Discord, браузеры и звонки • без внешнего VPN";
+    }
+
+    private void toggleSystemDpiFromProxyScreen() {
+        Context ctx = getContext();
+        if (ctx == null || getParentActivity() == null) return;
+        Context app = ctx.getApplicationContext();
+        String st = org.colgram.core.ColgramCallSocksTunnel.systemDpiStatus(app);
+        if ("running".equals(st) || "starting".equals(st) || colgramSystemDpiPending) {
+            colgramSystemDpiPending = false;
+            org.colgram.core.ColgramRouteEpoch.next();
+            warpOperations.execute(() -> {
+                org.colgram.core.ColgramCallSocksTunnel.stopSystemDpi(app);
+                refreshWarpState();
+            });
+            refreshWarpState();
+            return;
+        }
+        if (org.colgram.core.ColgramConfig.isWarpEnabled() || warpOperationsGate.isPending()) {
+            cancelWarpFromProxyScreen();
+        }
+        colgramSubscription.stopForAlternativeRoute(app);
+        try {
+            android.content.Intent prepare = android.net.VpnService.prepare(getParentActivity());
+            if (prepare != null) {
+                colgramSystemDpiPending = true;
+                startActivityForResult(prepare, REQ_SYSTEM_DPI_CONSENT);
+                refreshWarpState();
+            } else {
+                startSystemDpiNow(app);
+            }
+        } catch (Throwable failure) {
+            colgramSystemDpiPending = false;
+            android.widget.Toast.makeText(ctx, "Нет разрешения Android VPN", android.widget.Toast.LENGTH_SHORT).show();
+            refreshWarpState();
+        }
+    }
+
+    private void startSystemDpiNow(Context app) {
+        colgramSystemDpiPending = true;
+        org.colgram.core.ColgramRouteEpoch.next();
+        refreshWarpState();
+        warpOperations.execute(() -> {
+            String err = null;
+            try {
+                org.colgram.core.ColgramCallSocksTunnel.startSystemDpi(app);
+            } catch (Throwable t) {
+                err = t.getMessage() != null ? t.getMessage() : t.getClass().getSimpleName();
+            }
+            final String finalErr = err;
+            AndroidUtilities.runOnUIThread(() -> {
+                colgramSystemDpiPending = false;
+                if (finalErr != null && getContext() != null) {
+                    android.widget.Toast.makeText(getContext(), "Локальный обход: " + finalErr, android.widget.Toast.LENGTH_LONG).show();
+                }
+                refreshWarpState();
+            });
+        });
+    }
