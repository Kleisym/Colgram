+        if (org.colgram.core.ColgramConfig.isWarpEnabled() && org.colgram.core.ColgramWarpTunnel.isConnected()) {
+            return ColgramSubscriptionControls.label("всегда включён · поверх WARP", "Always on · WARP active above it");
+        }
