+
+        TextView previewLabel = new TextView(ctx);
+        previewLabel.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourcesProvider));
+        previewLabel.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13);
+        previewLabel.setMaxLines(4);
+        previewLabel.setEllipsize(TextUtils.TruncateAt.END);
+        root.addView(previewLabel, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 4, 0, 2));
+
+        Runnable updatePreview = () -> {
+            String pat = patternInput.getText() != null ? patternInput.getText().toString() : "";
+            String rep = replaceInput.getText() != null ? replaceInput.getText().toString() : "";
+            if (pat.isEmpty()) {
+                previewLabel.setText("Диапазон: " + targetSlice.length() + " симв.");
+                return;
+            }
+            try {
+                ColgramTextTools.RegexResult res = ColgramTextTools.applyRegexReplace(
+                        targetSlice, pat, rep, ignoreCaseBox.isChecked());
+                previewLabel.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourcesProvider));
+                previewLabel.setText("Совпадений: " + res.matches + "\n" + res.text);
+            } catch (Exception ex) {
+                previewLabel.setTextColor(Theme.getColor(Theme.key_text_RedRegular, resourcesProvider));
+                previewLabel.setText("Ошибка RegEx: " + ex.getMessage());
+            }
+        };
+        TextWatcher watcher = new TextWatcher() {
+            @Override public void beforeTextChanged(CharSequence s, int a, int b, int c) {}
+            @Override public void onTextChanged(CharSequence s, int a, int b, int c) {}
+            @Override public void afterTextChanged(Editable s) { updatePreview.run(); }
+        };
