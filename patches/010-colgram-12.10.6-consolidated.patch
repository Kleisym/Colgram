+                || key == key_windowBackgroundWhiteGrayText2
+                || key == key_windowBackgroundWhiteGrayText3
+                || key == key_windowBackgroundWhiteGrayText4
+                || key == key_windowBackgroundWhiteGrayText5
+                || key == key_windowBackgroundWhiteGrayText6
+                || key == key_windowBackgroundWhiteGrayText7
+                || key == key_windowBackgroundWhiteGrayText8
