+    /** A foreground colour that is readable on every dark surface we test against. */
+    private static int colgramReadableForeground(boolean cyber) {
+        if (cyber) {
+            return COLGRAM_CYBER_TEXT;
+        }
+        int candidate = colgramGetColorInternal(key_windowBackgroundWhiteBlackText, null, true);
+        if (colgramWorstWcagContrast(candidate, false, null) >= 4.5) {
+            return candidate;
+        }
+        return 0xffffffff;
+    }
