+                    }
+                }
+            } catch (Exception ex) {
+                Toast.makeText(ctx, "Ошибка RegEx: " + ex.getMessage(), Toast.LENGTH_SHORT).show();
+            }
+        });
+        builder.setNeutralButton("Только цифры", (d, w) -> {
+            patternInput.setText("[^0-9]+");
+            replaceInput.setText("");
+        });
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null);
