+    private static final class ColgramPageDotsView extends View {
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF pillRect = new RectF();
+        private int pageCount = 1;
+        private float scrollProgress = 0f;
+        private int activeColor = 0xFF3390EC;
+        private int inactiveColor = 0x55888888;
+
+        ColgramPageDotsView(Context context) {
+            super(context);
+            updateThemeColors(Theme.getColor(Theme.key_glass_tabSelected), Theme.getColor(Theme.key_glass_tabUnselected));
+        }
+
+        void setPageCount(int count) {
+            this.pageCount = Math.max(1, count);
+            setVisibility(this.pageCount > 1 ? VISIBLE : GONE);
+            requestLayout();
+            invalidate();
+        }
+
+        void setScrollProgress(float progress) {
+            float clamped = MathUtils.clamp(progress, 0f, Math.max(0, pageCount - 1));
+            if (Math.abs(this.scrollProgress - clamped) > 0.002f) {
+                this.scrollProgress = clamped;
+                invalidate();
+            }
+        }
+
+        void updateThemeColors(int selected, int unselected) {
+            this.activeColor = selected != 0 ? selected : 0xFF3390EC;
+            this.inactiveColor = Theme.multAlpha(unselected != 0 ? unselected : 0xFF94A3B8, 0.42f);
+            invalidate();
+        }
+
+        @Override
+        protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+            if (pageCount <= 1) {
+                setMeasuredDimension(0, dp(5));
+                return;
+            }
+            float dot = AndroidUtilities.dpf2(3.5f);
+            float activeW = AndroidUtilities.dpf2(10f);
+            float gap = AndroidUtilities.dpf2(4.5f);
+            int w = (int) Math.ceil(activeW + (pageCount - 1) * (dot + gap) + AndroidUtilities.dpf2(4f));
+            setMeasuredDimension(w, dp(5));
+        }
+
+        @Override
+        protected void onDraw(@NonNull Canvas canvas) {
+            if (pageCount <= 1) return;
+            float dot = AndroidUtilities.dpf2(3.5f);
+            float activeW = AndroidUtilities.dpf2(10f);
+            float gap = AndroidUtilities.dpf2(4.5f);
+            float totalW = activeW + (pageCount - 1) * (dot + gap);
+            float x = (getWidth() - totalW) * 0.5f;
+            float cy = getHeight() * 0.5f;
+            float r = dot * 0.5f;
+
+            for (int i = 0; i < pageCount; i++) {
+                float closeness = Math.max(0f, 1f - Math.abs(scrollProgress - i));
+                float w = lerp(dot, activeW, closeness);
+                paint.setColor(ColorUtils.blendARGB(inactiveColor, activeColor, closeness));
+                pillRect.set(x, cy - r, x + w, cy + r);
+                canvas.drawRoundRect(pillRect, r, r, paint);
+                x += w + gap;
+            }
+        }
+    }
