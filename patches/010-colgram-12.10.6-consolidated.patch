+    public void colgramSetFolderPinned(int filterId, LongSparseIntArray pinnedDialogs) {
+        if (mainPreferences == null) {
+            return;
+        }
+        String key = "colgramFolderPins_" + filterId;
+        if (pinnedDialogs == null || pinnedDialogs.size() == 0) {
+            mainPreferences.edit().remove(key).apply();
+            return;
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0, n = pinnedDialogs.size(); i < n; i++) {
+            if (sb.length() > 0) sb.append(';');
+            sb.append(pinnedDialogs.keyAt(i)).append(':').append(pinnedDialogs.valueAt(i));
+        }
+        mainPreferences.edit().putString(key, sb.toString()).apply();
+    }
+
+    public void colgramApplyFolderLocalPins(DialogFilter filter) {
+        if (filter == null || mainPreferences == null) {
+            return;
+        }
+        String raw = mainPreferences.getString("colgramFolderPins_" + filter.id, "");
+        if (raw == null || raw.isEmpty()) {
+            return;
+        }
+        for (String pair : raw.split(";")) {
+            int colon = pair.indexOf(':');
+            if (colon <= 0) continue;
+            try {
+                long did = Long.parseLong(pair.substring(0, colon));
+                int pinIdx = Integer.parseInt(pair.substring(colon + 1));
+                if (filter.pinnedDialogs.indexOfKey(did) < 0) {
+                    filter.pinnedDialogs.put(did, pinIdx);
+                    if (!filter.alwaysShow.contains(did)) {
+                        filter.alwaysShow.add(did);
+                    }
+                }
+            } catch (Exception ignore) {
+            }
+        }
+    }
