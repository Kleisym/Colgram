+    private void refreshColgramExtraTabsState() {
+        int unselected = getThemedColor(Theme.key_glass_tabUnselected);
+        int selected = getThemedColor(Theme.key_glass_tabSelected);
+        int selectedText = getThemedColor(Theme.key_glass_tabSelectedText);
+        int defaultText = getThemedColor(Theme.key_glass_defaultText);
+        if (defaultText == 0) {
+            defaultText = unselected;
+        }
+        for (int i = 0; i < colgramExtraTabHolders.size(); i++) {
+            ColgramExtraTabHolder h = colgramExtraTabHolders.get(i);
+            boolean active = ColgramBottomBarConfig.isActionActive(h.def.id);
+            h.pillBg.setColor(active ? Theme.multAlpha(selected, 0.14f) : 0x00000000);
+            if (h.def.iconRes != R.drawable.koliti_avatar) {
+                h.icon.setColorFilter(active ? selected : unselected, PorterDuff.Mode.SRC_IN);
+            }
+            h.label.setTextColor(active ? (selectedText != 0 ? selectedText : selected) : defaultText);
+        }
+        if (colgramPageDotsView != null) {
+            colgramPageDotsView.updateThemeColors(selected, unselected);
+        }
