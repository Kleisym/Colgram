+        end = Math.max(0, Math.min(end, editable.length()));
+        if (start == end && editable.length() > 0) {
+            start = 0;
+            end = editable.length();
+        }
+        return new int[]{start, end};
+    }
+
+    private void applyColgramSimpleTransform(int itemId) {
+        Editable editable = getText();
+        if (editable == null || editable.length() == 0) return;
+        int[] range = resolveEditRange(editable);
+        int start = range[0];
+        int end = range[1];
+        if (start >= end) return;
+        String slice = editable.subSequence(start, end).toString();
+        String transformed;
+        if (itemId == R.id.colgram_menu_text_case) {
+            transformed = ColgramTextTools.cycleCase(slice);
+        } else if (itemId == R.id.colgram_menu_text_layout) {
+            transformed = ColgramTextTools.swapKeyboardLayout(slice);
+        } else {
+            transformed = ColgramTextTools.stripInvisibleChars(slice);
+        }
+        editable.replace(start, end, transformed);
+        setSelection(start, Math.min(editable.length(), start + transformed.length()));
+        if (delegate != null) {
+            delegate.onSpansChanged();
+        }
+    }
+
+    private void showRegexReplaceDialog() {
