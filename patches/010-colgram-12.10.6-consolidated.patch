+
+    private void colgramSetLocalPin(long dialogId, boolean add) {
+        java.util.LinkedHashSet<Long> set = colgramLocalPinIds();
+        boolean changed;
+        if (add) {
+            // Insert newly pinned chat at the TOP (first in LinkedHashSet -> highest pinnedNum!)
+            java.util.LinkedHashSet<Long> updated = new java.util.LinkedHashSet<>();
+            updated.add(dialogId);
+            updated.addAll(set);
+            changed = !updated.equals(set);
+            set = updated;
+        } else {
+            changed = set.remove(dialogId);
+        }
+        if (!changed) {
+            return;
+        }
+        StringBuilder sb = new StringBuilder();
+        for (Long l : set) {
+            if (sb.length() > 0) {
+                sb.append(',');
+            }
+            sb.append(l);
+        }
+        mainPreferences.edit().putString("colgramLocalPins", sb.toString()).apply();
+    }
+
+    private void colgramSaveLocalPinOrder(int folderId, ArrayList<Long> orderedDids) {
+        if (mainPreferences == null) {
+            return;
+        }
+        // Preserve pins belonging to other folders (e.g., Archive folderId=1 when saving main folderId=0)
+        java.util.LinkedHashSet<Long> merged = new java.util.LinkedHashSet<>();
+        if (orderedDids != null) {
+            for (int i = 0; i < orderedDids.size(); i++) {
+                Long id = orderedDids.get(i);
+                if (id != null) merged.add(id);
+            }
+        }
+        for (Long existing : colgramLocalPinIds()) {
+            TLRPC.Dialog d = dialogs_dict.get(existing);
+            if (d != null && d.folder_id != folderId) {
+                merged.add(existing);
+            }
+        }
+        StringBuilder sb = new StringBuilder();
+        for (Long id : merged) {
+            if (sb.length() > 0) sb.append(',');
+            sb.append(id);
+        }
+        mainPreferences.edit().putString("colgramLocalPins", sb.toString()).apply();
+    }
+
+    private void colgramReapplyLocalPins() {
+        java.util.LinkedHashSet<Long> set = colgramLocalPinIds();
+        if (set.isEmpty()) {
+            return;
+        }
+        // Apply exact saved pinned ordering (first in set = highest pinnedNum -> top of list)
+        int total = set.size();
+        int idx = 0;
+        for (Long id : set) {
+            TLRPC.Dialog d = dialogs_dict.get(id);
+            if (d != null && !(d instanceof TLRPC.TL_dialogFolder)) {
+                d.pinned = true;
+                d.pinnedNum = total - idx;
+            }
+            idx++;
+        }
+    }
