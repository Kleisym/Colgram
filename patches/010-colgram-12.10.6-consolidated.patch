+    private static int colgramEffectiveOutBubbleSelected(boolean cyber, ResourcesProvider provider) {
+        int sel = colgramEffectiveColor(key_chat_outBubbleSelected, cyber, provider);
+        if (sel != 0 && (sel >>> 24) >= 0x40) {
+            int g1 = colgramRawGradientStop(key_chat_outBubbleGradient1, cyber, provider);
