+        if (key == key_windowBackgroundWhite) {
+            return COLGRAM_CYBER_BG;
+        }
+        if (key == key_windowBackgroundGray || key == key_windowBackgroundGrayShadow) {
+            return COLGRAM_CYBER_BG_ALT;
+        }
+        if (key == key_actionBarDefault || key == key_actionBarDefaultSelector
+                || key == key_actionBarWhiteSelector) {
+            return COLGRAM_CYBER_SURFACE;
+        }
+        if (key == key_listSelector) {
+            return 0x22ff3344;
+        }
+        if (key == key_windowBackgroundWhiteInputField || key == key_dialogInputField) {
+            return COLGRAM_CYBER_FIELD;
+        }
+        // Accents
+        if (key == key_windowBackgroundWhiteInputFieldActivated
+                || key == key_dialogInputFieldActivated
+                || key == key_chats_actionBackground
+                || key == key_chats_actionPressedBackground
+                || key == key_dialogFloatingButton
+                || key == key_chat_messagePanelSend
+                || key == key_switchTrackChecked
+                || key == key_checkboxCheck
+                || key == key_featuredStickers_addButton
+                || key == key_featuredStickers_addButton2) {
+            return COLGRAM_CYBER_ACCENT;
+        }
+        if (key == key_featuredStickers_addButtonPressed) {
+            return COLGRAM_CYBER_ACCENT_DARK;
+        }
+        if (key == key_featuredStickers_buttonText
+                || key == key_chats_actionIcon
+                || key == key_dialogFloatingIcon
+                || key == key_chats_unreadCounterText) {
+            return 0xffffffff;
+        }
+        // The blue accent family. These were missing entirely, which is why turning
+        // Cyber on left every section header, link and blue icon stock blue next to a
+        // red background - the reported 'cyber is broken and ugly'. HeaderCell paints
+        // its label from windowBackgroundWhiteBlueHeader, so without this the palette
+        // covered backgrounds and body text but not the one thing that names a section.
+        if (key == key_windowBackgroundWhiteBlueHeader
+                || key == key_windowBackgroundWhiteBlueText
+                || key == key_windowBackgroundWhiteBlueText2
+                || key == key_windowBackgroundWhiteBlueText3
+                || key == key_windowBackgroundWhiteBlueText4
+                || key == key_windowBackgroundWhiteBlueText5
+                || key == key_windowBackgroundWhiteBlueText6
+                || key == key_windowBackgroundWhiteBlueText7
+                || key == key_windowBackgroundWhiteBlueIcon
+                || key == key_windowBackgroundWhiteLinkText
+                || key == key_windowBackgroundWhiteValueText
+                || key == key_dialogTextLink
+                || key == key_text_RedRegular
+                || key == key_text_RedBold) {
