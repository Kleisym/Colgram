+    private static int colgramMapColor(SparseIntArray colors, int key) {
+        if (colors != null) {
+            int idx = colors.indexOfKey(key);
+            if (idx >= 0) return colors.valueAt(idx);
+            int fb = fallbackKeys.get(key, -1);
+            if (fb >= 0) {
+                int fbIdx = colors.indexOfKey(fb);
+                if (fbIdx >= 0) return colors.valueAt(fbIdx);
+            }
+        }
+        return colgramGetColorInternal(key, null, true);
+    }
