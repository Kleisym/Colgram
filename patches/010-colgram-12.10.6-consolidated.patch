+    private static int colgramEffectiveColor(int key, boolean cyber, ResourcesProvider provider) {
+        if (cyber) {
+            int ov = colgramCyberOverride(key);
+            if (ov != 0) return ov;
+        }
+        int base = 0;
+        if (provider != null) {
+            base = provider.getRawColorUnchecked(key);
+        }
+        if (base == 0) {
+            base = colgramGetColorInternal(key, null, true);
+        }
+        int customAccent = org.colgram.core.ColgramDesignConfig.getAccentColor();
+        if (customAccent != 0) {
+            if (key == key_chats_unreadCounter || key == key_chats_actionBackground
+                    || key == key_featuredStickers_addButton || key == key_dialogFloatingButton) {
+                return customAccent;
+            }
+            if ((key == key_chat_outBubble || key == key_chat_outBubbleGradient1)
+                    && (cyber || colgramHasDarkSurface())) {
+                return colgramCustomDarkOutBubble(customAccent);
+            }
+        }
+        int customSurface = org.colgram.core.ColgramDesignConfig.resolveCustomBaseSurfaceColor();
+        if (customSurface != 0 && org.colgram.core.ColgramThemePolicy.isDarkColor(customSurface)) {
+            int r = (customSurface >> 16) & 0xFF;
+            int g = (customSurface >> 8) & 0xFF;
+            int b = customSurface & 0xFF;
+            int elevated = 0xFF000000 | (Math.min(255, r + 10) << 16) | (Math.min(255, g + 10) << 8) | Math.min(255, b + 12);
+            if (key == key_windowBackgroundWhite || key == key_dialogBackground
+                    || key == key_actionBarDefault || key == key_chats_menuBackground) {
+                return customSurface;
+            }
+            if (key == key_windowBackgroundGray || key == key_chat_messagePanelBackground
+                    || key == key_chat_topPanelBackground || key == key_dialogBackgroundGray) {
+                return elevated;
+            }
+        }
+        return base;
+    }
+
+    private static int colgramEffectiveColor(int key, boolean cyber) {
+        return colgramEffectiveColor(key, cyber, null);
+    }
+
+    private static int colgramRawGradientStop(int key, boolean cyber, ResourcesProvider provider) {
+        if (cyber) {
+            int ov = colgramCyberOverride(key);
+            if (ov != 0) return ov;
+        }
+        int customAccent = org.colgram.core.ColgramDesignConfig.getAccentColor();
+        if (customAccent != 0 && (cyber || colgramHasDarkSurface())
+                && (key == key_chat_outBubbleGradient1 || key == key_chat_outBubbleGradient2 || key == key_chat_outBubbleGradient3)) {
+            return key == key_chat_outBubbleGradient1 ? colgramCustomDarkOutBubble(customAccent) : 0;
+        }
+        if (provider != null) {
+            return provider.hasRawColorKey(key) ? provider.getRawColorUnchecked(key) : 0;
+        }
+        SparseIntArray active = currentColors;
+        if (active != null && active.indexOfKey(key) >= 0) {
+            return active.get(key);
+        }
+        return 0;
+    }
+
+    private static int colgramEffectiveOutBubble(boolean cyber, ResourcesProvider provider) {
+        int base = colgramEffectiveColor(key_chat_outBubble, cyber, provider);
+        int g1 = colgramRawGradientStop(key_chat_outBubbleGradient1, cyber, provider);
+        int g2 = colgramRawGradientStop(key_chat_outBubbleGradient2, cyber, provider);
+        int g3 = colgramRawGradientStop(key_chat_outBubbleGradient3, cyber, provider);
+        return org.colgram.core.ColgramThemePolicy.averageSurfaceColor(base, g1, g2, g3);
+    }
