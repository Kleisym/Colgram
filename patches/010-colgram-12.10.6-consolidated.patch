+    // Cyber palette. One place, so the whole scheme can be re-tuned without hunting
+    // for stray literals. Backgrounds and foregrounds are chosen TOGETHER - a palette
+    // that overrides only the background is how the UI ended up invisible.
+    private static final int COLGRAM_CYBER_BG        = 0xff0e0f12;
+    private static final int COLGRAM_CYBER_BG_ALT    = 0xff08090c;
+    private static final int COLGRAM_CYBER_SURFACE   = 0xff16181e;
+    private static final int COLGRAM_CYBER_FIELD     = 0xff22252d;
+    private static final int COLGRAM_CYBER_ACCENT    = 0xffff3344;
+    private static final int COLGRAM_CYBER_ACCENT_DARK = 0xffcc2233;
+    private static final int COLGRAM_CYBER_TEXT      = 0xffeef0f4;
+    private static final int COLGRAM_CYBER_TEXT_DIM  = 0xffc6cdd9;
+    private static final int COLGRAM_CYBER_ONLINE    = 0xff4ecc5e;
+    private static final int COLGRAM_CYBER_STATUS    = 0xff5ce079;
+    // Opaque high-contrast silver-white for liquid-glass labels, reply preview text, and icons
+    // so glass panels and reply bars never drop into grey-on-grey contrast.
+    private static final int COLGRAM_CYBER_GLASS_INK = 0xffe6ecf5;
+    private static final int COLGRAM_CYBER_HINT      = 0xffaab4c4;
+    private static final int COLGRAM_CYBER_DIVIDER   = 0xff2a2e37;
+    /**
+     * The cyber palette, applied as a COMPLETE set: foreground and background are
+     * decided together.
+     *
+     * Returns 0 when the key is not part of the scheme, which is the sentinel the
+     * callers test against - 0 is never a valid colour here.
+     *
+     * Why one method and not two inlined copies: the scheme must be applied on BOTH
+     * colour paths. getColor(key) reaches the wrapper, but
+     * getColor(key, ResourcesProvider) returns provider.getColor(key) directly when a
+     * provider is present, so a provider-scoped screen (a themed chat, a sheet) would
+     * otherwise get the cyber background and NOT the cyber text - black on near-black.
+     * Two copies of a palette drift; one cannot.
+     */
+    private static int colgramCyberOverride(int key) {
