+    /** Resolves an existing local media file for a message, decrypting `.enc` sidecar media to cache when needed. */
+    public File colgramResolvePlayableFile(TLRPC.Message message) {
+        if (message == null) {
+            return null;
+        }
+        if (!TextUtils.isEmpty(message.attachPath)) {
+            File attached = new File(message.attachPath);
+            if (attached.exists() && !attached.getName().endsWith(".enc")) {
+                return attached;
+            }
+        }
+        File path = getPathToMessage(message);
+        if (path != null && path.exists()) {
+            return path;
+        }
+        File encFile = path != null ? new File(path.getAbsolutePath() + ".enc") : null;
+        if ((encFile == null || !encFile.exists()) && path != null) {
+            File cacheDir = getDirectory(MEDIA_DIR_CACHE);
+            if (cacheDir != null) {
+                File cachePlain = new File(cacheDir, path.getName());
+                if (cachePlain.exists()) {
+                    return cachePlain;
+                }
+                File cacheEnc = new File(cacheDir, path.getName() + ".enc");
+                if (cacheEnc.exists()) {
+                    encFile = cacheEnc;
+                }
+            }
+        }
+        if (encFile == null || !encFile.exists()) {
+            return null;
+        }
+        File keyFile = new File(getInternalCacheDir(), encFile.getName() + ".key");
+        if (!keyFile.exists() && encFile.getParentFile() != null) {
+            keyFile = new File(encFile.getParentFile(), encFile.getName() + ".key");
+        }
+        if (!keyFile.exists()) {
+            return null;
+        }
+        String baseName = encFile.getName();
+        if (baseName.endsWith(".enc")) {
+            baseName = baseName.substring(0, baseName.length() - 4);
+        }
+        File outDir = getDirectory(MEDIA_DIR_CACHE);
+        if (outDir == null) {
+            outDir = getInternalCacheDir();
+        }
+        if (outDir == null) {
+            return null;
+        }
+        File outFile = new File(outDir, "colgram_dec_" + baseName);
+        if (outFile.exists() && outFile.length() == encFile.length()) {
+            return outFile;
+        }
+        File tmpFile = new File(outDir, "colgram_dec_" + baseName + ".tmp");
+        try (org.telegram.messenger.secretmedia.EncryptedFileInputStream fis =
+                     new org.telegram.messenger.secretmedia.EncryptedFileInputStream(encFile, keyFile);
+             FileOutputStream fos = new FileOutputStream(tmpFile)) {
+            byte[] buf = new byte[16384];
+            int n;
+            while ((n = fis.read(buf, 0, buf.length)) > 0) {
+                fos.write(buf, 0, n);
+            }
+            fos.flush();
+            if (tmpFile.renameTo(outFile)) {
+                return outFile;
+            }
+            return tmpFile;
+        } catch (Throwable e) {
+            FileLog.e(e);
+            if (tmpFile.exists()) {
+                tmpFile.delete();
+            }
+            return null;
+        }
+    }
 }
