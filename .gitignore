# --- Secrets: never commit these ---
*.txt.token
gfpat.txt
.env
.env.*
secrets/
*.keystore
*.jks
local.properties

# --- Build output ---
__pycache__/
*.pyc
scripts/error_log.txt
scripts/build_*.log
scripts/*.log
# Root-level Gradle logs from the local build loop (build-ipv4fix2.log, build-mediahist.log, ...).
# `scripts/*.log` above does not reach these, which is why ~100 of them had accumulated untracked.
/build*.log
/build*.txt
# javac scratch + daemon dumps produced while diagnosing build stalls.
javac.*.args
daemon-stack*.txt
crash-run.log
ci-artifact/

# --- Built / signed artifacts (too large to version; use Releases) ---
dist/
*.apk
*.apk.idsig
*.aab

# --- Cloned upstream / heavy trees ---
Telegram-Src/

# --- Android SDK provisioned locally (not part of the repo) ---
.android-sdk/

# --- Toolchain provisioned locally ---
#
# These are the binaries a build runs against, not the build's output. They are provisioned
# per machine (JDK 17, the Android NDK, the Go toolchain) and total about 2.8 GB, which is more
# than GitHub's 100 MB per-file ceiling once compressed and several times over the practical
# limit for a repository. scripts/gradle-preflight.sh checks for them at build time, so a fresh
# clone plus the provisioning step is a working build without them ever being versioned.
tools/jdk17/
tools/ndk/
tools/go/
tools/gocache/
tools/gopath/

# Go build output from building libcolgrammasque.so. The .so files that ship in the APK are
# committed under colgram-core/src/main/jniLibs/; these are the intermediates on the way there.
tools/warpgo/**/*.exe
tools/warpgo/**/*.zip
tools/warpgo/**/*.bak
tools/warpgo/**/*.log
tools/warpgo/**/*.err
tools/warpgo/**/*.out

# --- Vendored native libraries ---
# These are fetched per platform by the vendor sync, not authored here.
vendor/libbox-binding/
vendor/colgram-singbox/src/main/jniLibs/

# --- Tooling scratch ---
.workbuddy-ai/tmp/

# Local agent state: memory logs, caches, session scratch. Not project source.
.workbuddy-ai/

# --- Local agent tooling state (not project source) ---
.agents/
.openclaw/
.opencode/

# Anti-spam userbot runtime state. The vendored .py modules under
# colgram-core/src/main/assets/antispam/ are source and ARE tracked; anything the userbot
# generates at runtime (session files, SQLite DB, generated config) must never ship, and a
# test run that points init_app_storage() at the assets dir will create them there.
colgram-core/src/main/assets/antispam/storage/
colgram-core/src/main/assets/antispam/config.txt
colgram-core/src/main/assets/antispam/*.session
colgram-core/src/main/assets/antispam/*.session-journal
colgram-core/src/main/assets/antispam/__pycache__/
