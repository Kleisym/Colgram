{
  "name": "colgram-remotion",
  "version": "12.10.6",
  "private": true,
  "description": "Colgram 12.10.6 Cinematic 1080p60 Release Video built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ColgramRelease ../Colgram/docs/media/colgram-release.mp4 --codec=h264 --crf=18",
    "poster": "remotion still src/index.ts ColgramPoster ../Colgram/docs/media/colgram-release-poster.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.546",
    "@remotion/google-fonts": "^4.0.546",
    "@remotion/lottie": "^4.0.546",
    "@remotion/renderer": "^4.0.546",
    "@remotion/transitions": "^4.0.546",
    "lottie-web": "^5.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.546"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
